{
  "name": "@qwrobinson/linearctl",
  "version": "0.8.14",
  "description": "Agent-first CLI for the Linear API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwrobins/linearctl.git"
  },
  "bugs": {
    "url": "https://github.com/qwrobins/linearctl/issues"
  },
  "homepage": "https://github.com/qwrobins/linearctl#readme",
  "type": "module",
  "bin": {
    "linearctl": "dist/cli/main.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:binary": "bun scripts/build.ts --binary",
    "generate": "bun run embed:skills && bun scripts/generate-curated-manifest.ts && bun run docs:update-readme-commands",
    "check:generated": "bun scripts/check-generated.ts",
    "smoke:binary": "bun scripts/smoke-binary.ts",
    "embed:skills": "bun scripts/embed-skills.ts",
    "docs:update-readme-commands": "bun scripts/update-readme-command-table.ts",
    "copy:assets": "bun scripts/copy-assets.ts",
    "generate:api-manifest": "bun run src/generated/generate-manifest.ts",
    "regenerate:schema": "bun src/generated/regenerate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
